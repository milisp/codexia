{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codexia-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codexia-telemetry",
      // REPLACE with the id printed by `wrangler d1 create codexia-telemetry`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Logs only contain what the code logs (errors, never bodies, IPs or headers).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
