{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codexia",
  "version": "../package.json",
  "identifier": "dev.milisp.codexia",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Codexia",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 360,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 22
        },
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri://localhost localhost:*; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: http: tauri://*; style-src 'self' 'unsafe-inline' https: http:; img-src 'self' asset: https://asset.localhost blob: data: https: http:; font-src 'self' data: https: http: tauri://*; connect-src 'self' ipc: https://ipc.localhost http://ipc.localhost http://localhost:* https: http: ws: wss:; frame-src 'self' data: about: http://localhost:* http://127.0.0.1:* https://*;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/**",
          "$HOME/.cache/**/*",
          "$HOME/.codex/.tmp/**/*",
          "$HOME/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "codexia"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCM0Q1ODU3RTRGMkJFRgpSV1R2SzA5K2hkV3pBNHI0NlpIYzYyb2tvR09wWFJIMWhsRE5teHRCL0RzQWsvY1F4WWZzdGtXdwo=",
      "endpoints": [
        "https://github.com/milisp/codexia/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  }
}